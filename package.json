{
  "name": "stellar-relayer-api",
  "version": "1.0.0",
  "description": "Stellar relayer API for PadiPay Web2.5 escrow service",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/app.js",
    "dev": "nodemon src/app.js",
    "test": "jest --runInBand --coverage",
    "lint": "eslint src tests",
    "postinstall": "prisma generate"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverage": true,
    "coverageDirectory": "coverage",
    "coverageThreshold": {
      "global": {
        "statements": 80,
        "branches": 75,
        "functions": 80,
        "lines": 80
      }
    },
    "transform": {
      "^.+\\.js$": "babel-jest"
    },
    "transformIgnorePatterns": [
      "/node_modules/(?!(@stellar|@noble|uint8array-extras)/)"
    ],
    "globalSetup": "<rootDir>/tests/globalSetup.js",
    "setupFiles": [
      "<rootDir>/tests/setupEnv.js"
    ],
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setupAfterEnv.js"
    ]
  },
  "keywords": [
    "padipay",
    "stellar",
    "relayer",
    "soroban"
  ],
  "author": "PadiPay",
  "license": "ISC",
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@stellar/stellar-sdk": "^16.2.0",
    "axios": "^1.6.8",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "google-auth-library": "^10.9.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "node-fetch": "^2.7.0",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@babel/preset-env": "^8.0.2",
    "@eslint/js": "^10.0.1",
    "@types/pg": "^8.20.3",
    "@types/swagger-ui-express": "^4.1.8",
    "babel-jest": "^30.4.1",
    "eslint": "^10.6.0",
    "jest": "^30.4.2",
    "nodemon": "^3.1.4",
    "prisma": "^7.9.1",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "find-my-way": "^9.7.0"
  }
}
